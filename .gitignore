# Les secrets, jamais au depot.
.env
.env.*
# ...mais le MODELE, si : sans lui, personne ne sait quoi remplir.
# C'est la regle « .env.* » du depot d'origine qui l'avalait, et le modele
# n'y a donc jamais ete versionne.
!.env.example
*.pyc
__pycache__/
.pytest_cache/
.ruff_cache/
/staticfiles/
/media/
/backups/
*.sqlite3
.venv/
*.egg-info/
build/
dist/

# Residu possible d une bascule de branche depuis le depot d origine.
/backoffice/
