# macOS
.DS_Store
**/.DS_Store

# Secrets / environnement (règle 9 : jamais dans Git)
.env
.env.*
# ...mais le MODELE de configuration, si : sans lui, personne ne sait quoi
# remplir. La regle « .env.* » ci-dessus l'avalait, et backoffice/.env.example
# n'a donc jamais ete versionne jusqu'au 09/11/2026.
!.env.example
*.key
*.pem

# Dépendances / build (à venir chantiers C/D)
node_modules/
dist/
build/
.next/

# Archives de déploiement (régénérables : voir livrables/C-site/DEPLOIEMENT_VPS.md)
*.zip

# Éditeurs
.vscode/
.idea/
*.swp

# Produit du build du site (regenere par build.mjs)
livrables/C-site/dist/

# Film de presentation : les fichiers video et son sont generes (voir son LISEZMOI)
livrables/A-marketing/film-presentation/sortie/
# ...et les bruitages de banque ne se redistribuent pas : leur licence l'interdit,
# et ce depot est public. `sons/banque.json` dit lesquels, `telecharger-sons.py` les recupere.
livrables/A-marketing/film-presentation/sons/*
!livrables/A-marketing/film-presentation/sons/banque.json
# La voix enregistree, quand elle existera : la prestation d'un comedien, pas une source.
livrables/A-marketing/film-presentation/voix/

# Python
__pycache__/
*.pyc
