# Mandataire nginx pour le back-office, a poser sur le VPS.
#
# ⚠️ Le VPS fait tourner HestiaCP. Hestia REGENERE les fichiers de
# /etc/nginx/conf.d/domains/ a chaque modification du domaine : un fichier
# edite a la main y est efface sans prevenir. Ce fichier est donc un
# MODELE Hestia, a installer dans :
#
#     /usr/local/hestia/data/templates/web/nginx/backoffice.tpl   (HTTP)
#     /usr/local/hestia/data/templates/web/nginx/backoffice.stpl  (HTTPS)
#
# puis applique au domaine :
#
#     v-change-web-domain-tpl <utilisateur> backoffice.vformations.fr backoffice
#
# Les variables %...% sont remplacees par Hestia a la generation.
# Procedure complete : deploiement/premiere-installation.md

server {
    listen      %ip%:%web_ssl_port% ssl;
    http2       on;
    server_name %domain_idn% %alias_idn%;

    ssl_certificate      %ssl_pem%;
    ssl_certificate_key  %ssl_key%;
    ssl_protocols        TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Le back-office n'a rien a faire dans un index de moteur : il ne
    # contient que des donnees de prospects.
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    # Un formulaire de devis ou un import CSV depassent vite la valeur par
    # defaut de 1 Mo, et nginx renvoie alors un 413 sans explication.
    client_max_body_size 25m;

    access_log /var/log/nginx/domains/%domain%.log combined;
    error_log  /var/log/nginx/domains/%domain%.error.log error;

    location / {
        # Gunicorn n'ecoute que sur la boucle locale : rien ne l'atteint
        # sans passer par ici, qui porte le TLS et les en-tetes.
        proxy_pass http://127.0.0.1:8000;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Sans cet en-tete, Django se croit en HTTP derriere le mandataire,
        # refuse les cookies « secure » et boucle sur sa propre redirection
        # HTTPS. C'est le piege classique du deploiement derriere un
        # mandataire — voir SECURE_PROXY_SSL_HEADER dans settings/prod.py.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        # Un import CSV de plusieurs milliers de lignes depasse 30 s.
        proxy_read_timeout    120s;

        proxy_buffering on;
        proxy_redirect off;
    }

    # Le webhook Meta n'a pas de session : il s'authentifie par la signature
    # HMAC de son corps. Le corps brut doit donc arriver INTACT — toute
    # reecriture invaliderait la signature.
    location /integrations/meta/webhook/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering on;
        proxy_read_timeout 30s;
    }

    # Les fichiers statiques sont servis par WhiteNoise depuis Django : un
    # seul chemin de verite, aucun volume a resynchroniser avec nginx. On se
    # contente d'autoriser le cache long, les noms portant une empreinte.
    location /static/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    include %home%/%user%/conf/web/%domain%/nginx.ssl.conf_*;
}
