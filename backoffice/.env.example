# Copier en .env et remplir. Ce fichier-ci est un modele : il ne contient
# aucun secret et il est le seul des deux a etre suivi par Git.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generer avec : make secret
SECRET_KEY=
# Domaines servis, separes par une virgule
ALLOWED_HOSTS=backoffice.example.fr
CSRF_TRUSTED_ORIGINS=https://backoffice.example.fr

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=backoffice
POSTGRES_USER=backoffice
POSTGRES_PASSWORD=
DATABASE_URL=postgres://backoffice:${POSTGRES_PASSWORD}@db:5432/backoffice

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- SMTP externe (sous-domaine dedie, SPF + DKIM + DMARC) ----------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Sauvegardes ----------------------------------------------------------
# Phrase de passe du chiffrement des dumps. Sans elle, aucune restauration.
BACKUP_PASSPHRASE=
# Destination hors VPS (rclone remote:chemin). Vide = pas de copie distante.
BACKUP_REMOTE=

# --- Supervision ----------------------------------------------------------
# Pas de Sentry ici, et c'est deliberé : une trace d'erreur de ce projet
# contient des donnees de prospects (nom, email, telephone, SIREN). Les
# erreurs partent par courriel aux DJANGO_ADMINS et restent dans
# journaux/backoffice.log, qui tourne chaque nuit sur 15 jours. Voir
# docs/ARCHITECTURE.md.

# --- Meta Lead Ads --------------------------------------------------------
# Les trois valeurs viennent du tableau de bord de l'application Meta.
# Laissees vides, la verification de signature ECHOUE par defaut : c'est
# voulu, un webhook ouvert accepterait de faux leads de n'importe qui.
#
# META_APP_SECRET  : Parametres > General > Cle secrete.
#   Sert a verifier l'en-tete X-Hub-Signature-256 sur le corps brut.
# META_VERIFY_TOKEN: chaine que VOUS choisissez, a recopier a l'identique
#   dans Webhooks > Verifier le jeton. Meta la renvoie a la poignee de main.
# META_PAGE_ACCESS_TOKEN : jeton de Page (pas d'utilisateur). Permissions
#   « leads_retrieval » et « pages_manage_ads », soumises en App Review.
#   Sans lui, le webhook enregistre le lead mais ne peut pas lire ses
#   reponses : la reception reste rejouable (manage.py rejouer_receptions).
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# Version du Graph API. A relever quand Meta deprecie : les versions
# anciennes cessent de repondre sans preavis utile.
META_API_VERSION=v27.0

# --- Zone commerciale -----------------------------------------------------
# Departement cible de la resolution SIREN. L'API Recherche d'entreprises
# filtre sur les ETABLISSEMENTS : une entreprise ayant un etablissement ici
# est un prospect local meme si son siege est ailleurs.
DEPARTEMENT_CIBLE=34

# --- Journalisation et alertes --------------------------------------------
# Qui recoit les erreurs de production, au format « Nom:adresse », separes
# par des virgules. Sans cette valeur, AUCUNE erreur ne remonte a personne :
# elles restent dans le fichier de journal du serveur.
DJANGO_ADMINS=Pierre:pierre@exemple.fr
# Adresse expeditrice des alertes (par defaut, DEFAULT_FROM_EMAIL).
SERVER_EMAIL=

# --- Securite --------------------------------------------------------------
# Rien a regler : le verrouillage apres 5 echecs de connexion et la
# limitation de debit du webhook sont actifs par defaut. Ils s'appuient sur
# REDIS_URL ci-dessus — sans Redis joignable, le verrou degrade en « laisser
# passer » plutot qu'en « tout bloquer », et le journal le signale.

# --- Drapeaux de service ---------------------------------------------------
# Les trois valeurs ci-dessous sont FAUSSES par defaut. Chacune declenche un
# effet qui ne se reprend pas : des messages partis, des appels payants, des
# prospects crees. Elles ne se mettent a vrai qu'en connaissance de cause.

# Expedition reelle des sequences de relance. A faux, le moteur calcule et
# prepare les envois mais n'expedie rien. Un .env recopie d'une
# preproduction ne doit pas suffire a declencher une campagne.
SEQUENCES_ENVOI_REEL=False

# Veille BODACC quotidienne (immatriculations de l'Herault sur les NAF
# cibles). A faux, la tache planifiee s'arrete immediatement ; la commande
# `manage.py veille_bodacc` reste utilisable a la main.
VEILLE_BODACC_AUTOMATIQUE=False

# Cle Google Places. Vide, l'enrichissement est simplement saute. ATTENTION :
# l'API est facturee a l'appel, et les conditions de Google Maps Platform
# n'accordent AUCUNE exception de cache au nom, a l'adresse, a la note ni
# aux avis — seul le `place_id` est stocke, et un test le verifie.
GOOGLE_PLACES_API_KEY=
