# Copier en .env puis remplir. Ne JAMAIS committer le fichier .env.

# Sous-domaine pointant vers l'IP du VPS (enregistrement DNS A), ex: leads.mondomaine.fr
DOMAIN=

# --- Meta (developers.facebook.com > ton app) ---
# Mot de passe libre que tu inventes, a recopier dans la config Webhook Meta
META_VERIFY_TOKEN=
# Parametres de l'app > Base > Cle secrete
META_APP_SECRET=
# Token de PAGE (pas utilisateur) avec permissions leads_retrieval + pages_manage_metadata
META_PAGE_ACCESS_TOKEN=
# Optionnel : IDs des formulaires a traiter, separes par des virgules (vide = tous)
META_FORM_IDS=
META_GRAPH_VERSION=v21.0

# --- WhatsApp Business Cloud API ---
# Token d'utilisateur systeme (Business Manager) avec whatsapp_business_messaging
WA_ACCESS_TOKEN=
# WhatsApp > Configuration de l'API > "ID du numero de telephone"
WA_PHONE_NUMBER_ID=
# Modele approuve par Meta, 3 variables : {{1}} prenom, {{2}} sujet, {{3}} message
WA_TEMPLATE_NAME=lead_bienvenue
WA_TEMPLATE_LANG=fr
# true = ne pas utiliser WhatsApp, SMS uniquement (pratique en attendant la validation Meta)
SMS_ONLY=false

DEFAULT_COUNTRY_CODE=33

# --- SMS de secours ---
# httpsms = envoie depuis TON numero via ton telephone Android (appli httpSMS)
# twilio  = numero/expediteur Twilio
SMS_PROVIDER=httpsms

HTTPSMS_API_KEY=
# Ton numero perso au format international, ex: +33612345678
HTTPSMS_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
